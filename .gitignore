# Secrets
.env
.env.*
!.env.example

# Personal Claude Code overrides
.claude/settings.local.json

# Media never goes in git — the whole video workspace is ignored
workspace/
#   Video/ and Video/Subtitles/ stay in the repo (README + .gitkeep); their contents don't.
Video/*
!Video/README.md
!Video/Subtitles/
Video/Subtitles/*
!Video/Subtitles/.gitkeep
*.mp4
*.mov
*.MOV
*.mkv
*.webm
*.m4a
*.mp3
*.wav
*.aac
*.heic
*.HEIC
*.jpg
*.JPG
*.jpeg
*.png
*.srt
*.vtt
out/
renders/

# Build / caches
node_modules/
__pycache__/
*.pyc
.venv/
*.stackdump

# Reel-look tools (.claude/kit): env, matting model, transcripts
.claude/kit/.venv/
.claude/kit/models/
.work/
*.transcript.json
