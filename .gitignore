!Video/Subtitles/
Video/Subtitles/*
!Video/Subtitles/.gitkeep
*.mp4
*.mov
*.MOV
*.mkv
*.webm
*.m4a
*.mp3
*.wav
*.aac
*.heic
*.HEIC
*.jpg
*.JPG
*.jpeg
*.png
*.srt
*.vtt
out/
renders/

